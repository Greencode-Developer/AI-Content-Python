# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Chỉ cần khai báo khi chạy local / CI. Trên AWS (EC2, Lambda, ECS) dùng IAM Role
# gắn trực tiếp — không cần key nào cả (zero-credential = tiết kiệm và an toàn nhất).

# Access key (bỏ trống nếu dùng IAM Role hoặc aws configure)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Session token — chỉ cần khi dùng temporary credentials (STS AssumeRole)
AWS_SESSION_TOKEN=

# Region chứa model Nova Micro (mặc định us-east-1 nếu không khai báo)
AWS_BEDROCK_REGION=us-east-1
